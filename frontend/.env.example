# Car Price Predictor Pro - Environment Variables
# Copy this file to .env.local and update values as needed

# Anthropic Claude API (for ChatBot assistant - get key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ML Backend API (Python FastAPI)
# Default: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth Backend API (Node.js Express)
# Default: http://localhost:3001
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001

# Supabase (used by lib/supabase.ts and auth callback)
NEXT_PUBLIC_SUPABASE_URL=https://fehkzrrahgyesxzrwlme.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZlaGt6cnJhaGd5ZXN4enJ3bG1lIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkxNzcwNjEsImV4cCI6MjA4NDc1MzA2MX0.AI8QaX8nOP8UwcfmgbGN2EN4jmK94i98Kpd3ZtPDZRQ

# Supabase Dashboard > Authentication > URL Configuration > Redirect URLs
# Add these for OAuth (Google, etc.) to work with the auth callback:
#   http://localhost:3002/en/auth/callback
#   http://localhost:3002/ar/auth/callback
#   http://localhost:3002/ku/auth/callback
# For production, add: https://yourdomain.com/{en,ar,ku}/auth/callback

# CRITICAL: Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# Required on the Node server that runs Next.js API routes (e.g. Vercel) for push + prefs:
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# Use the same public key for NEXT_PUBLIC_VAPID_PUBLIC_KEY and VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URL for Web Push
VAPID_SUBJECT=mailto:support@carwiseiq.com

# Canonical site URL for notification click-through links (no trailing slash)
NEXT_PUBLIC_APP_URL=https://carwiseiq.com

# Admin/cron: POST /api/notifications/send
NOTIFICATIONS_CRON_SECRET=

# Production: set NEXT_PUBLIC_API_BASE_URL=https://api.carwiseiq.com
# .env.local is gitignored; only NEXT_PUBLIC_* are exposed to the browser.
